# Mẫu cấu hình staging. Chỉ có khóa, KHÔNG có giá trị bí mật.
# Trên máy chủ staging: sao chép thành `.env` (cùng thư mục docker-compose.yml), điền giá trị thật, chmod 600.
# `.env` bị .gitignore, không được commit. Giá trị bí mật nên lấy từ kho secret của nền tảng được chọn.

# --- Image (do GitHub Actions đẩy lên GHCR; tag do deploy.sh truyền vào, không đặt IMAGE_TAG ở đây) ---
IMAGE_REPO=ghcr.io/ute-lms/lms-api

# --- Mạng ---
# Cổng ứng dụng trên máy chủ (container luôn nghe 8080).
APP_PORT=8080

# --- Bắt buộc ---
# Khóa ký JWT, tối thiểu 32 byte. Sinh bằng: openssl rand -base64 48
JWT_SECRET=

# --- Tài khoản admin đầu tiên (chỉ dùng khi collection users còn rỗng; để trống nếu đã có admin) ---
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Tùy chọn ---
# Nguồn gốc (origin) frontend được gọi API, phân tách bằng dấu phẩy. Để trống = không cho origin nào (chờ chọn
# địa chỉ frontend staging, Q06/Q07).
APP_CORS_ALLOWED_ORIGINS=
# Ghi đè chuỗi kết nối MongoDB (mặc định trỏ tới dịch vụ mongo trong compose, replicaSet=rs0).
# MONGODB_URI=
# Định dạng log console: ecs | logstash | gelf. Đặt trống để quay về định dạng văn bản của application.properties.
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
